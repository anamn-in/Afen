{
  "name": "@anamnadmin/afen",
  "version": "1.0.0",
  "description": "Universal Debugging Intelligence Layer",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "afen": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "ui/dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "_moduleAliases": {
    "@api": "./dist/src/api",
    "@core": "./dist/src/core",
    "@models": "./dist/src/models",
    "@storage": "./dist/src/storage",
    "@queries": "./dist/src/queries",
    "@integrations": "./dist/src/integrations",
    "@utils": "./dist/src/core/utils"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "build:backend": "tsc && tsc-alias",
    "build:ui": "cd ../ui && npm run build",
    "start": "node dist/src/index.js",
    "afen": "node dist/src/cli.js",
    "test": "jest",
    "coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "bench": "ts-node -r tsconfig-paths/register -P ./tsconfig.json ../scripts/runBenchmarks.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anamnadmin/Afen.git"
  },
  "keywords": [
    "error-detection",
    "observability",
    "opentelemetry",
    "typescript"
  ],
  "author": "Afen Contributors",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "babel-jest": "^30.4.1",
    "babel-plugin-istanbul": "^8.0.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "module-alias": "^2.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}