{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "../src",
    "baseUrl": ".",
    "paths": {
      "*": ["../node_modules/*", "./node_modules/*"],
      "@core/*": ["../src/core/*"],
      "@models/*": ["../src/models/*"],
      "@api/*": ["../src/api/*"],
      "@storage/*": ["../src/storage/*"],
      "@cli/*": ["../src/cli/*"],
      "@core/engines/*": ["../src/core/engines/*"]
    },
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "downlevelIteration": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["../src/**/*"],
  "exclude": ["node_modules", "dist"]
}