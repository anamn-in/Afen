{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "../src",
    "baseUrl": "../src",
    "paths": {
      "@core/*": ["core/*"],
      "@models/*": ["models/*"],
      "@api/*": ["api/*"],
      "@storage/*": ["storage/*"],
      "@cli/*": ["cli/*"],
      "*": [
        "../configs/node_modules/*",
        "../node_modules/*",
        "node_modules/*"
      ]
    },
    "typeRoots": [
      "./node_modules/@types",
      "../node_modules/@types"
    ],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "downlevelIteration": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": false,
    "noEmitOnError": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["../src/**/*"],
  "exclude": ["node_modules", "dist"]
}